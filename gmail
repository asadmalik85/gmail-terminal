# CLI Entry Point & Terminal Setup
# ==============================================================================

def disable_flow_control():
    try:
        fd = sys.stdin.fileno()
        old_attrs = termios.tcgetattr(fd)
        new_attrs = termios.tcgetattr(fd)
        new_attrs[0] &= ~termios.IXON
        termios.tcsetattr(fd, termios.TCSANOW, new_attrs)
        return old_attrs
    except Exception:
        return None

def restore_flow_control(old_attrs):
    if old_attrs:
        try:
            termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, old_attrs)
        except Exception:
            pass

def main():
    parser = argparse.ArgumentParser(description="Terminal & Headless CLI Gmail Client")
    parser.add_argument("--demo", action="store_true", help="Launch or run in demo mode with sample emails")
    parser.add_argument("--setup", action="store_true", help="Reconfigure Gmail account credentials")

    # Headless CLI actions
    cli_group = parser.add_argument_group("Headless CLI Commands")
    cli_group.add_argument("--unread", action="store_true", help="List unread emails")
    cli_group.add_argument("--list", action="store_true", help="List recent emails in a folder")
    cli_group.add_argument("--folder", default="INBOX", help="Target folder (default: INBOX)")
    cli_group.add_argument("--limit", type=int, default=20, help="Number of emails to return (default: 20)")
    cli_group.add_argument("--read", metavar="MSG_ID", help="Read and print full details of an email by ID")
    cli_group.add_argument("--reply", metavar="MSG_ID", help="Reply to an email by ID (requires --body)")
    cli_group.add_argument("--send", action="store_true", help="Send a new email (requires --to, --subject, --body)")
    cli_group.add_argument("--to", help="Recipient email address for --send")
    cli_group.add_argument("--subject", help="Email subject for --send or custom reply subject")
    cli_group.add_argument("--body", help="Email body text (or '-' to read from stdin)")
    cli_group.add_argument("--no-quote", action="store_true", help="Do not quote original message in reply")
    cli_group.add_argument("--mark-read", nargs="+", metavar="MSG_ID", help="Mark email(s) as read (accepts multiple IDs or 'all')")
    cli_group.add_argument("--trash", nargs="+", metavar="MSG_ID", help="Move email(s) to Trash (accepts multiple IDs)")
    cli_group.add_argument("--json", action="store_true", help="Output results in JSON format")

    args = parser.parse_args()

    cfg = load_config()

    if args.setup:
        cfg = interactive_setup()
        if not cfg:
            sys.exit(0)

    # Check if a headless CLI action was requested
    is_headless = any([
        args.unread,
        args.list,
        args.read is not None,
        args.reply is not None,
        args.send,
        args.mark_read is not None,
        args.trash is not None,
    ])

    if args.demo:
        backend = GmailBackend(demo=True)
    elif cfg:
        backend = GmailBackend(cfg=cfg, demo=False)
        if not backend.connect():
            err_msg = "Failed to authenticate with Gmail IMAP. Run 'gmail --setup' to update credentials, or use '--demo'."
            if args.json:
                print(json.dumps({"error": err_msg}, indent=2))
            else:
                print(err_msg, file=sys.stderr)
            sys.exit(1)
    else:
        err_msg = "No Gmail account configured. Run 'gmail --setup' to configure, or pass '--demo' to test."
        if is_headless:
            if args.json:
                print(json.dumps({"error": err_msg}, indent=2))
            else:
                print(err_msg, file=sys.stderr)
            sys.exit(1)

        print(err_msg)
        print("\nChoose an option:")
        print("  1) Configure Gmail Account (Setup Wizard)")
        print("  2) Launch in Demo Mode (Preview UI with sample emails)")
        print("  3) Exit\n")
        choice = input("Enter choice [1/2/3]: ").strip()
        if choice == "1":
            cfg = interactive_setup()
            if not cfg:
                sys.exit(0)
            backend = GmailBackend(cfg=cfg, demo=False)
            backend.connect()
        elif choice == "2":
            backend = GmailBackend(demo=True)
        else:
            sys.exit(0)

    # Handle Headless execution
    if is_headless:
        code = handle_headless_cli(args, backend)
        sys.exit(code if code is not None else 0)

    # Interactive Curses TUI
    old_attrs = disable_flow_control()
    try:
        curses.wrapper(lambda stdscr: GmailTUI(stdscr, backend).run())
    finally:
        restore_flow_control(old_attrs)

if __name__ == "__main__":
    main()
