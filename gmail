# ==============================================================================

def get_body_text(arg_body):
    if arg_body == "-":
        return sys.stdin.read()
    return arg_body or ""

def handle_headless_cli(args, backend):
    # 1. Unread emails
    if args.unread:
        messages = backend.get_unread_messages(folder=args.folder, limit=args.limit)
        if args.json:
            print(json.dumps({"count": len(messages), "folder": args.folder, "messages": messages}, indent=2))
        else:
            if not messages:
                print(f"No unread messages in {args.folder}.")
            else:
                print(f"Unread messages in {args.folder} ({len(messages)}):")
                print("-" * 75)
                for m in messages:
                    print(f"[{m['id']}] {m['date']} | {m['sender'][:25]:<25} | {m['subject']}")
        return 0

    # 2. List messages
    if args.list:
        messages = backend.get_messages(folder=args.folder, limit=args.limit)
        if args.json:
            print(json.dumps({"count": len(messages), "folder": args.folder, "messages": messages}, indent=2))
        else:
            if not messages:
                print(f"No messages in {args.folder}.")
            else:
                print(f"Recent messages in {args.folder} ({len(messages)}):")
                print("-" * 75)
                for m in messages:
                    status = "● " if "\\Seen" not in m["flags"] else "  "
                    star = "★ " if "\\Flagged" in m["flags"] else "  "
                    print(f"[{m['id']}] {status}{star}{m['date']} | {m['sender'][:25]:<25} | {m['subject']}")
        return 0

    # 3. Read specific email
    if args.read:
        detail = backend.get_message_detail(args.folder, args.read)
        if not detail:
            if args.json:
                print(json.dumps({"error": f"Message ID '{args.read}' not found in folder '{args.folder}'."}, indent=2))
            else:
                print(f"Error: Message ID '{args.read}' not found in {args.folder}.", file=sys.stderr)
            return 1
        if args.json:
            print(json.dumps(detail, indent=2))
        else:
            print(f"ID:       {detail['id']}")
            print(f"From:     {detail['sender']}")
            if detail.get('reply_to'):
                print(f"Reply-To: {detail['reply_to']}")
            print(f"Date:     {detail['date']}")
            print(f"Subject:  {detail['subject']}")
            print("-" * 75)
            print(detail.get('body') or "[Empty Message]")
        return 0

    # 4. Reply to email
    if args.reply:
        body_text = get_body_text(args.body)
        if not body_text.strip():
            err = "Error: --body is required to reply (use '--body \"...\"' or '--body -' for stdin)."
            if args.json:
                print(json.dumps({"error": err}, indent=2))
            else:
                print(err, file=sys.stderr)
            return 1

        quote = not args.no_quote
        success, msg = backend.reply_to_message(
            msg_id=args.reply,
            reply_text=body_text,
            folder=args.folder,
            quote=quote,
            custom_subject=args.subject
        )
        if args.json:
            print(json.dumps({"success": success, "message": msg, "id": args.reply}, indent=2))
        else:
            if success:
                print(f"Success: {msg}")
            else:
                print(f"Error: {msg}", file=sys.stderr)
        return 0 if success else 1

    # 5. Send new email
    if args.send:
        if not args.to:
            err = "Error: --to <recipient> is required to send an email."
            if args.json:
                print(json.dumps({"error": err}, indent=2))
            else:
                print(err, file=sys.stderr)
            return 1

        body_text = get_body_text(args.body)
        subject = args.subject or "(No Subject)"
        success, msg = backend.send_email(to_addr=args.to, subject=subject, body=body_text)
        if args.json:
            print(json.dumps({"success": success, "message": msg, "to": args.to, "subject": subject}, indent=2))
        else:
            if success:
                print(f"Success: {msg}")
            else:
                print(f"Error: {msg}", file=sys.stderr)
        return 0 if success else 1

    # 6. Mark read / unread
    if args.mark_read:
        target_ids = args.mark_read
        if "all" in target_ids:
            unreads = backend.get_unread_messages(folder=args.folder, limit=100)
            target_ids = [m["id"] for m in unreads]
        backend.set_flag(args.folder, target_ids, flag="\\Seen", remove=False)
        if args.json:
            print(json.dumps({"success": True, "action": "mark_read", "ids": target_ids}, indent=2))
        else:
            print(f"Marked {len(target_ids)} message(s) as read: {', '.join(target_ids)}")
        return 0

    # 7. Trash
    if args.trash:
        target_ids = args.trash
        backend.move_to_trash(args.folder, target_ids)
        if args.json:
            print(json.dumps({"success": True, "action": "trash", "ids": target_ids}, indent=2))
        else:
            print(f"Moved {len(target_ids)} message(s) to Trash: {', '.join(target_ids)}")
        return 0

    return None

