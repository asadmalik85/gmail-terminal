# External Editor Integration
# ==============================================================================

def launch_external_editor(initial_text=""):
    with tempfile.NamedTemporaryFile(mode="w+", suffix=".txt", delete=False, encoding="utf-8") as tf:
        tf.write(initial_text)
        temp_path = tf.name

    editor = os.environ.get("VISUAL") or os.environ.get("EDITOR") or "nvim"

    curses.def_prog_mode()
    curses.endwin()

    try:
        cmd = shlex.split(editor) + [temp_path]
        subprocess.call(cmd)
    except Exception:
        try:
            subprocess.call(["nvim", temp_path])
        except Exception:
            pass
    finally:
        curses.resetprog_mode()

    result = initial_text
    try:
        with open(temp_path, "r", encoding="utf-8") as f:
            result = f.read()
    except Exception:
        pass
    finally:
        try:
            os.remove(temp_path)
        except OSError:
            pass

    return result

