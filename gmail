class GmailBackend:
    def __init__(self, cfg=None, demo=False):
        self.demo = demo
        self.cfg = cfg
        self.imap = None
        self.folders = [
            ("INBOX", "Inbox"),
            ("[Gmail]/Starred", "Starred"),
            ("[Gmail]/Sent Mail", "Sent"),
            ("[Gmail]/Drafts", "Drafts"),
            ("[Gmail]/Trash", "Trash"),
            ("[Gmail]/All Mail", "All Mail"),
        ]
        self.current_folder = "INBOX"

    def connect(self):
        if self.demo:
            return True
        try:
            context = ssl.create_default_context()
            self.imap = imaplib.IMAP4_SSL(self.cfg["imap_host"], self.cfg["imap_port"], ssl_context=context)
            self.imap.login(self.cfg["email"], self.cfg["app_password"])
            return True
        except Exception:
            return False

    def get_messages(self, folder="INBOX", limit=35):
        if self.demo:
            return list(DEMO_EMAILS)

        self.current_folder = folder
        try:
            status, _ = self.imap.select(f'"{folder}"')
            if status != "OK":
                return []
            _, data = self.imap.search(None, "ALL")
            msg_ids = data[0].split()
            if not msg_ids:
                return []

            msg_ids = msg_ids[-limit:][::-1]
            results = []

            for mid in msg_ids:
                _, mdata = self.imap.fetch(mid, "(BODY.PEEK[HEADER.FIELDS (SUBJECT FROM DATE MESSAGE-ID REPLY-TO REFERENCES)] FLAGS)")
                if not mdata or not mdata[0]:
                    continue

                raw_header = mdata[0][1]
                flags_part = mdata[0][0].decode("utf-8", errors="ignore")
                flags = []
                if "\\Seen" in flags_part:
                    flags.append("\\Seen")
                if "\\Flagged" in flags_part:
                    flags.append("\\Flagged")

                msg = email.message_from_bytes(raw_header)
                subj = decode_mime_words(msg.get("Subject", "(No Subject)"))
                from_ = decode_mime_words(msg.get("From", "(Unknown Sender)"))
                date_ = decode_mime_words(msg.get("Date", ""))
                reply_to = decode_mime_words(msg.get("Reply-To", ""))
                msg_id = msg.get("Message-ID", "")
                references = msg.get("References", "")

                parsed_date = email.utils.parsedate_to_datetime(date_) if date_ else None
                formatted_date = parsed_date.strftime("%b %d %H:%M") if parsed_date else date_[:16]

                results.append({
                    "id": mid.decode("utf-8"),
                    "flags": flags,
                    "sender": from_,
                    "reply_to": reply_to,
                    "message_id": msg_id,
                    "references": references,
                    "subject": subj,
                    "date": formatted_date,
                    "body": None
                })
            return results
        except Exception:
            return []

    def get_unread_messages(self, folder="INBOX", limit=20):
        if self.demo:
            return [m for m in DEMO_EMAILS if "\\Seen" not in m["flags"]][:limit]

        self.current_folder = folder
        try:
            status, _ = self.imap.select(f'"{folder}"')
            if status != "OK":
                return []
            _, data = self.imap.search(None, "UNSEEN")
            msg_ids = data[0].split()
            if not msg_ids:
                return []

            msg_ids = msg_ids[-limit:][::-1]
            results = []

            for mid in msg_ids:
                _, mdata = self.imap.fetch(mid, "(BODY.PEEK[HEADER.FIELDS (SUBJECT FROM DATE MESSAGE-ID REPLY-TO REFERENCES)] FLAGS)")
                if not mdata or not mdata[0]:
                    continue

                raw_header = mdata[0][1]
                flags_part = mdata[0][0].decode("utf-8", errors="ignore")
                flags = []
                if "\\Seen" in flags_part:
                    flags.append("\\Seen")
                if "\\Flagged" in flags_part:
                    flags.append("\\Flagged")

                msg = email.message_from_bytes(raw_header)
                subj = decode_mime_words(msg.get("Subject", "(No Subject)"))
                from_ = decode_mime_words(msg.get("From", "(Unknown Sender)"))
                date_ = decode_mime_words(msg.get("Date", ""))
                reply_to = decode_mime_words(msg.get("Reply-To", ""))
                msg_id = msg.get("Message-ID", "")
                references = msg.get("References", "")

                parsed_date = email.utils.parsedate_to_datetime(date_) if date_ else None
                formatted_date = parsed_date.strftime("%b %d %H:%M") if parsed_date else date_[:16]

                results.append({
                    "id": mid.decode("utf-8"),
                    "flags": flags,
                    "sender": from_,
                    "reply_to": reply_to,
                    "message_id": msg_id,
                    "references": references,
                    "subject": subj,
                    "date": formatted_date,
                    "body": None
                })
            return results
        except Exception:
            return []

    def fetch_body(self, folder, msg_id):
        if self.demo:
            for item in DEMO_EMAILS:
                if str(item["id"]) == str(msg_id):
                    return item.get("body", "")
            return "Demo body"
        try:
            self.imap.select(f'"{folder}"')
            _, data = self.imap.fetch(str(msg_id).encode("utf-8"), "(RFC822)")
            raw_email = data[0][1]
            msg = email.message_from_bytes(raw_email)
            return extract_body(msg)
        except Exception as e:
            return f"Error loading email body: {e}"

    def get_message_detail(self, folder, msg_id):
        if self.demo:
            for item in DEMO_EMAILS:
                if str(item["id"]) == str(msg_id):
                    return dict(item)
            return None

        try:
            self.imap.select(f'"{folder}"')
            _, data = self.imap.fetch(str(msg_id).encode("utf-8"), "(RFC822 FLAGS)")
            if not data or not data[0]:
                return None
            raw_email = data[0][1]
            flags_part = data[0][0].decode("utf-8", errors="ignore") if isinstance(data[0][0], bytes) else ""
            flags = []
            if "\\Seen" in flags_part:
                flags.append("\\Seen")
            if "\\Flagged" in flags_part:
                flags.append("\\Flagged")

            msg = email.message_from_bytes(raw_email)
            subj = decode_mime_words(msg.get("Subject", "(No Subject)"))
            from_ = decode_mime_words(msg.get("From", "(Unknown Sender)"))
            date_ = decode_mime_words(msg.get("Date", ""))
            reply_to = decode_mime_words(msg.get("Reply-To", ""))
            msg_id_header = msg.get("Message-ID", "")
            references = msg.get("References", "")
            body = extract_body(msg)

            parsed_date = email.utils.parsedate_to_datetime(date_) if date_ else None
            formatted_date = parsed_date.strftime("%b %d %H:%M") if parsed_date else date_[:16]

            return {
                "id": str(msg_id),
                "flags": flags,
                "sender": from_,
                "reply_to": reply_to,
                "message_id": msg_id_header,
                "references": references,
                "subject": subj,
                "date": formatted_date,
                "body": body
            }
        except Exception:
            return None

    def toggle_flag(self, folder, msg_id, flag="\\Seen"):
        if self.demo:
            for item in DEMO_EMAILS:
                if str(item["id"]) == str(msg_id):
                    if flag in item["flags"]:
                        item["flags"].remove(flag)
                    else:
                        item["flags"].append(flag)
            return
        try:
            self.imap.select(f'"{folder}"')
            status, data = self.imap.fetch(str(msg_id).encode("utf-8"), "(FLAGS)")
            flags_str = data[0].decode("utf-8") if data and data[0] else ""
            action = "-FLAGS" if flag in flags_str else "+FLAGS"
            self.imap.store(str(msg_id).encode("utf-8"), action, flag)
        except Exception:
            pass

    def set_flag(self, folder, msg_ids, flag="\\Seen", remove=False):
        if not msg_ids:
            return
        if isinstance(msg_ids, (str, int)):
            msg_ids = [str(msg_ids)]
        else:
            msg_ids = [str(mid) for mid in msg_ids]

        if self.demo:
            for item in DEMO_EMAILS:
                if str(item["id"]) in msg_ids:
                    if remove and flag in item["flags"]:
                        item["flags"].remove(flag)
                    elif not remove and flag not in item["flags"]:
                        item["flags"].append(flag)
            return

        try:
            self.imap.select(f'"{folder}"')
            id_str = ",".join(msg_ids)
            action = "-FLAGS" if remove else "+FLAGS"
            self.imap.store(id_str, action, flag)
        except Exception:
            pass

    def move_to_trash(self, folder, msg_id):
        if isinstance(msg_id, (list, tuple, set)):
            target_ids = [str(m) for m in msg_id]
        else:
            target_ids = [str(msg_id)]

        if self.demo:
            global DEMO_EMAILS
            DEMO_EMAILS = [m for m in DEMO_EMAILS if str(m["id"]) not in target_ids]
            return
        try:
            self.imap.select(f'"{folder}"')
            id_str = ",".join(target_ids)
            self.imap.copy(id_str, '"[Gmail]/Trash"')
            self.imap.store(id_str, "+FLAGS", "\\Deleted")
            self.imap.expunge()
        except Exception:
            pass

    def send_email(self, to_addr, subject, body, in_reply_to=None, references=None):
        if self.demo:
            now_str = email.utils.formatdate(localtime=True)
            new_id = str(len(DEMO_EMAILS) + 1)
            new_msg = {
                "id": new_id,
                "flags": ["\\Seen"],
                "sender": f"Me <{self.cfg.get('email', 'me@gmail.com') if self.cfg else 'me@gmail.com'}>",
                "reply_to": "",
                "message_id": f"<{new_id}@gmail.mock>",
                "references": references or "",
                "subject": subject,
                "date": now_str[5:16],
                "body": body,
            }
            DEMO_EMAILS.insert(0, new_msg)
            return True, "Email sent successfully (Demo Mode)."

        if not self.cfg or not self.cfg.get("email") or not self.cfg.get("app_password"):
            return False, "Gmail credentials not configured."

        try:
            msg = EmailMessage()
            msg["From"] = self.cfg["email"]
            msg["To"] = to_addr
            msg["Subject"] = subject
            if in_reply_to:
                msg["In-Reply-To"] = in_reply_to
            if references:
                msg["References"] = references
            msg.set_content(body)

            smtp_host = self.cfg.get("smtp_host", "smtp.gmail.com")
            smtp_port = int(self.cfg.get("smtp_port", 465))
            context = ssl.create_default_context()

            if smtp_port == 465:
                with smtplib.SMTP_SSL(smtp_host, smtp_port, context=context, timeout=20) as server:
                    server.login(self.cfg["email"], self.cfg["app_password"])
                    server.send_message(msg)
            else:
                with smtplib.SMTP(smtp_host, smtp_port, timeout=20) as server:
                    server.starttls(context=context)
                    server.login(self.cfg["email"], self.cfg["app_password"])
                    server.send_message(msg)
            return True, "Email sent successfully!"
        except Exception as e:
            return False, f"Failed to send email: {e}"

    def reply_to_message(self, msg_id, reply_text, folder="INBOX", quote=True, custom_subject=None):
        detail = self.get_message_detail(folder, msg_id)
        if not detail:
            return False, f"Message ID '{msg_id}' not found in folder '{folder}'."

        raw_to = detail.get("reply_to") or detail.get("sender") or ""
        _, addr = email.utils.parseaddr(raw_to)
        recipient = addr if addr else raw_to
        if not recipient:
            return False, f"Could not determine recipient email address from message {msg_id}."

        if custom_subject:
            subject = custom_subject
        else:
            orig_subj = detail.get("subject", "").strip()
            if orig_subj.lower().startswith("re:"):
                subject = orig_subj
            else:
                subject = f"Re: {orig_subj}" if orig_subj else "Re:"

        if quote:
            orig_date = detail.get("date", "")
            orig_from = detail.get("sender", "")
            raw_body = detail.get("body") or ""
            quote_intro = f"On {orig_date}, {orig_from} wrote:"
            quoted_lines = "\n".join(f"> {line}" for line in raw_body.splitlines())
            full_body = f"{reply_text}\n\n{quote_intro}\n{quoted_lines}"
        else:
            full_body = reply_text

        in_reply_to = detail.get("message_id")
        orig_refs = detail.get("references", "")
        if orig_refs and in_reply_to:
            references = f"{orig_refs} {in_reply_to}".strip()
        elif in_reply_to:
            references = in_reply_to
        else:
            references = None

        return self.send_email(
            to_addr=recipient,
            subject=subject,
            body=full_body,
            in_reply_to=in_reply_to,
            references=references
        )

