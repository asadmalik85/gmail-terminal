        self.stdscr.nodelay(False)
        self.stdscr.keypad(True)

        self.status_msg = "Fetching emails..."
        self.render()
        self.refresh_emails()
        self.status_msg = f"Loaded {len(self.emails)} messages."

        while True:
            self.render()
            try:
                key = self.stdscr.getch()
            except KeyboardInterrupt:
                break

            if key == curses.KEY_RESIZE:
                continue

            if self.view_mode == "LIST":
                if not self.handle_list_keys(key):
                    break
            elif self.view_mode == "READER":
                self.handle_reader_keys(key)
            elif self.view_mode == "COMPOSE":
                self.handle_compose_keys(key)
            elif self.view_mode == "HELP":
                if key in (ord('q'), 27, ord('?'), ord(' ')):
                    self.view_mode = "LIST"
            elif self.view_mode == "FOLDERS":
                self.handle_folder_keys(key)

    def refresh_emails(self):
        folder_internal, _ = self.backend.folders[self.folder_idx]
        self.emails = self.backend.get_messages(folder_internal)
        self.selected_idx = 0
        self.scroll_offset = 0

    def get_filtered_emails(self):
        if not self.search_query:
            return self.emails
        q = self.search_query.lower()
        return [
            m for m in self.emails
            if q in m["subject"].lower() or q in m["sender"].lower()
        ]

    # --------------------------------------------------------------------------
    # List Mode Key Handling
    # --------------------------------------------------------------------------

    def handle_list_keys(self, key):
        items = self.get_filtered_emails()
        count = len(items)

        if key in (ord('q'), 27):
            if self.search_query:
                self.search_query = ""
                self.status_msg = "Search cleared."
            else:
                return False
        elif key in (curses.KEY_UP, ord('k')):
            if self.selected_idx > 0:
                self.selected_idx -= 1
        elif key in (curses.KEY_DOWN, ord('j')):
            if self.selected_idx < count - 1:
                self.selected_idx += 1
        elif key == ord('g'):
            self.selected_idx = 0
        elif key == ord('G'):
            self.selected_idx = max(0, count - 1)
        elif key == curses.KEY_PPAGE:
            self.selected_idx = max(0, self.selected_idx - 10)
        elif key == curses.KEY_NPAGE:
            self.selected_idx = min(max(0, count - 1), self.selected_idx + 10)
        elif key in (curses.KEY_ENTER, 10, 13, ord('o')):
            if count > 0:
                self.current_email = items[self.selected_idx]
                self.status_msg = "Fetching email content..."
                self.render()
                folder_internal, _ = self.backend.folders[self.folder_idx]
                self.current_email["body"] = self.backend.fetch_body(folder_internal, self.current_email["id"])
                if "\\Seen" not in self.current_email["flags"]:
                    self.backend.toggle_flag(folder_internal, self.current_email["id"], "\\Seen")
                    self.current_email["flags"].append("\\Seen")
                self.reader_scroll = 0
                self.view_mode = "READER"
        elif key == ord('c'):
            self.start_compose()
        elif key == ord('r'):
            if count > 0:
                self.start_reply(items[self.selected_idx])
        elif key in (ord('R'), 18):
            self.status_msg = "Refreshing..."
            self.render()
            self.refresh_emails()
            self.status_msg = "Mailbox refreshed."
        elif key == ord('u'):
            if count > 0:
                curr = items[self.selected_idx]
                folder_internal, _ = self.backend.folders[self.folder_idx]
                self.backend.toggle_flag(folder_internal, curr["id"], "\\Seen")
                self.status_msg = "Toggled Read/Unread."
        elif key == ord('s'):
            if count > 0:
                curr = items[self.selected_idx]
                folder_internal, _ = self.backend.folders[self.folder_idx]
                self.backend.toggle_flag(folder_internal, curr["id"], "\\Flagged")
                self.status_msg = "Toggled Star."
        elif key == ord('d'):
            if count > 0:
                curr = items[self.selected_idx]
                folder_internal, _ = self.backend.folders[self.folder_idx]
                self.backend.move_to_trash(folder_internal, curr["id"])
                self.emails = [m for m in self.emails if m["id"] != curr["id"]]
                if self.selected_idx >= len(self.get_filtered_emails()):
                    self.selected_idx = max(0, len(self.get_filtered_emails()) - 1)
                self.status_msg = "Moved email to Trash."
        elif key in (ord('f'), 9):
            self.view_mode = "FOLDERS"
        elif key == ord('/'):
            self.prompt_search()
        elif key == ord('?'):
            self.view_mode = "HELP"
        return True

    # --------------------------------------------------------------------------
    # Reader Mode Key Handling
    # --------------------------------------------------------------------------

    def handle_reader_keys(self, key):
        if key in (ord('q'), 27, ord('b')):
            self.view_mode = "LIST"
            self.status_msg = "Ready."
        elif key == ord('r'):
            self.start_reply(self.current_email)
        elif key == ord('c'):
            self.start_compose()
        elif key in (curses.KEY_UP, ord('k')):
            self.reader_scroll = max(0, self.reader_scroll - 1)
        elif key in (curses.KEY_DOWN, ord('j')):
            self.reader_scroll += 1
        elif key == curses.KEY_PPAGE:
            self.reader_scroll = max(0, self.reader_scroll - 15)
        elif key == curses.KEY_NPAGE:
            self.reader_scroll += 15
        elif key == ord('g'):
            self.reader_scroll = 0
        elif key == ord('u'):
            folder_internal, _ = self.backend.folders[self.folder_idx]
            self.backend.toggle_flag(folder_internal, self.current_email["id"], "\\Seen")
            self.status_msg = "Marked as unread."
            self.view_mode = "LIST"
        elif key == ord('d'):
            folder_internal, _ = self.backend.folders[self.folder_idx]
            self.backend.move_to_trash(folder_internal, self.current_email["id"])
            self.emails = [m for m in self.emails if m["id"] != self.current_email["id"]]
            self.status_msg = "Moved to Trash."
            self.view_mode = "LIST"
        elif key == ord('?'):
            self.view_mode = "HELP"

    # --------------------------------------------------------------------------
    # Folder Mode Key Handling
    # --------------------------------------------------------------------------

    def handle_folder_keys(self, key):
        if key in (ord('q'), 27):
            self.view_mode = "LIST"
        elif key in (curses.KEY_UP, ord('k')):
            self.folder_idx = (self.folder_idx - 1) % len(self.backend.folders)
        elif key in (curses.KEY_DOWN, ord('j')):
            self.folder_idx = (self.folder_idx + 1) % len(self.backend.folders)
        elif key in (curses.KEY_ENTER, 10, 13, ord(' ')):
            self.view_mode = "LIST"
            self.status_msg = f"Opening {self.backend.folders[self.folder_idx][1]}..."
            self.render()
            self.refresh_emails()
            self.status_msg = f"Opened {self.backend.folders[self.folder_idx][1]}."

    # --------------------------------------------------------------------------
    # Compose & Reply Management
    # --------------------------------------------------------------------------

    def start_compose(self):
        self.compose_to = ""
        self.compose_subject = ""
        self.compose_body = [""]
        self.compose_focus = "to"
        self.compose_to_cursor = 0
        self.compose_subj_cursor = 0
        self.compose_body_cursor_y = 0
        self.compose_body_cursor_x = 0
        self.compose_scroll_y = 0
        self.compose_in_reply_to = None
        self.compose_references = None
        self.compose_return_mode = self.view_mode if self.view_mode in ("LIST", "READER") else "LIST"
        self.view_mode = "COMPOSE"
        self.status_msg = "Compose: Tab switches field | Ctrl+S sends | Ctrl+E opens $EDITOR (nvim)"

    def start_reply(self, email_item):
        if not email_item:
            return
        folder_internal, _ = self.backend.folders[self.folder_idx]
        if not email_item.get("body"):
            self.status_msg = "Loading message body for reply..."
            self.render()
            email_item["body"] = self.backend.fetch_body(folder_internal, email_item["id"])

        raw_to = email_item.get("reply_to") or email_item.get("sender") or ""
        _, addr = email.utils.parseaddr(raw_to)
        recipient = addr if addr else raw_to

        orig_subj = email_item.get("subject", "").strip()
        if orig_subj.lower().startswith("re:"):
            subj = orig_subj
        else:
            subj = f"Re: {orig_subj}" if orig_subj else "Re:"

        orig_date = email_item.get("date", "")
        orig_from = email_item.get("sender", "")
        raw_body = email_item.get("body") or ""
        quote_intro = f"On {orig_date}, {orig_from} wrote:"
        quoted_lines = [f"> {line}" for line in raw_body.splitlines()]

        self.compose_to = recipient
        self.compose_subject = subj
        self.compose_body = ["", "", quote_intro] + (quoted_lines if quoted_lines else ["> "])
        self.compose_focus = "body"
        self.compose_to_cursor = len(recipient)
        self.compose_subj_cursor = len(subj)
        self.compose_body_cursor_y = 0
        self.compose_body_cursor_x = 0
        self.compose_scroll_y = 0
        self.compose_in_reply_to = email_item.get("message_id")
        orig_refs = email_item.get("references", "")
        msg_id = email_item.get("message_id", "")
        if orig_refs and msg_id:
            self.compose_references = f"{orig_refs} {msg_id}".strip()
        elif msg_id:
            self.compose_references = msg_id
        else:
            self.compose_references = None

        self.compose_return_mode = self.view_mode if self.view_mode in ("LIST", "READER") else "LIST"
        self.view_mode = "COMPOSE"
        self.status_msg = f"Replying to {recipient} | Ctrl+S sends | Ctrl+E opens $EDITOR"

    def open_external_editor(self):
        initial_text = "\n".join(self.compose_body)
        new_text = launch_external_editor(initial_text)
        new_lines = new_text.splitlines()
        self.compose_body = new_lines if new_lines else [""]
        self.compose_body_cursor_y = min(self.compose_body_cursor_y, len(self.compose_body) - 1)
        self.compose_body_cursor_x = min(self.compose_body_cursor_x, len(self.compose_body[self.compose_body_cursor_y]))
        self.compose_scroll_y = max(0, self.compose_body_cursor_y - 5)
        self.status_msg = "Updated message from editor. Press Ctrl+S to Send."

    def send_compose(self):
        to_addr = self.compose_to.strip()
        if not to_addr or "@" not in to_addr:
            self.status_msg = "Error: Recipient email address is missing or invalid."
            return

        subject = self.compose_subject.strip()
        body = "\n".join(self.compose_body)

        self.status_msg = f"Sending email to {to_addr}..."
        self.render()

        success, msg = self.backend.send_email(
            to_addr=to_addr,
            subject=subject,
            body=body,
            in_reply_to=self.compose_in_reply_to,
            references=self.compose_references
        )

        if success:
            self.status_msg = msg
            self.view_mode = "LIST"
            self.refresh_emails()
        else:
            self.status_msg = f"Error: {msg}"

    def confirm_cancel_compose(self):
        has_user_text = (
            (self.compose_to and self.compose_return_mode != "READER") or
            (self.compose_subject and not self.compose_subject.startswith("Re:")) or
            any(line.strip() and not line.startswith(">") for line in self.compose_body)
        )
        if has_user_text:
            h, w = self.stdscr.getmaxyx()
            self.stdscr.attron(curses.color_pair(3) | curses.A_BOLD)
            prompt = " Discard draft? [y/N]: "
            self.stdscr.addstr(h - 1, 0, prompt.ljust(w - 1)[:w - 1])
            self.stdscr.attroff(curses.color_pair(3) | curses.A_BOLD)
            self.stdscr.refresh()
            ch = self.stdscr.getch()
            if ch not in (ord('y'), ord('Y')):
                self.status_msg = "Draft preserved."
                return
        self.view_mode = self.compose_return_mode
        self.status_msg = "Compose cancelled."

    def handle_compose_keys(self, key):
        if key in (19, 4, 24, curses.KEY_F10):
            self.send_compose()
            return
        if key == 5:
            self.open_external_editor()
            return
        if key in (27, 17):
            self.confirm_cancel_compose()
            return

        if key in (9, ord('\t'), 14):
            if self.compose_focus == "to":
                self.compose_focus = "subject"
            elif self.compose_focus == "subject":
                self.compose_focus = "body"
            elif self.compose_focus == "body":
                if key in (9, ord('\t')):
                    self.insert_body_tab()
                else:
                    self.compose_focus = "to"
            return
        elif key in (curses.KEY_BTAB, 353, 16):
            if self.compose_focus == "body":
                self.compose_focus = "subject"
            elif self.compose_focus == "subject":
                self.compose_focus = "to"
            elif self.compose_focus == "to":
                self.compose_focus = "body"
            return

        if self.compose_focus == "to":
            self.handle_single_line_key("to", key)
        elif self.compose_focus == "subject":
            self.handle_single_line_key("subject", key)
        elif self.compose_focus == "body":
            self.handle_body_key(key)

    def handle_single_line_key(self, field, key):
        text = self.compose_to if field == "to" else self.compose_subject
        cursor = self.compose_to_cursor if field == "to" else self.compose_subj_cursor

        if key in (curses.KEY_ENTER, 10, 13, curses.KEY_DOWN):
            if field == "to":
                self.compose_focus = "subject"
            else:
                self.compose_focus = "body"
            return
        elif key == curses.KEY_UP:
            if field == "subject":
                self.compose_focus = "to"
            return
        elif key in (curses.KEY_LEFT,):
            cursor = max(0, cursor - 1)
        elif key in (curses.KEY_RIGHT,):
            cursor = min(len(text), cursor + 1)
        elif key in (curses.KEY_HOME, 1):
            cursor = 0
        elif key in (curses.KEY_END,):
            cursor = len(text)
        elif key in (curses.KEY_BACKSPACE, 127, 8):
            if cursor > 0:
                text = text[:cursor - 1] + text[cursor:]
                cursor -= 1
        elif key == curses.KEY_DC:
            if cursor < len(text):
                text = text[:cursor] + text[cursor + 1:]
        elif 32 <= key <= 126 or (key >= 160 and key < 65536):
            char = chr(key)
            text = text[:cursor] + char + text[cursor:]
            cursor += 1

        if field == "to":
            self.compose_to = text
            self.compose_to_cursor = cursor
        else:
            self.compose_subject = text
            self.compose_subj_cursor = cursor

    def insert_body_tab(self):
        line = self.compose_body[self.compose_body_cursor_y]
        cx = self.compose_body_cursor_x
        self.compose_body[self.compose_body_cursor_y] = line[:cx] + "    " + line[cx:]
        self.compose_body_cursor_x += 4

    def handle_body_key(self, key):
        cy = self.compose_body_cursor_y
        cx = self.compose_body_cursor_x
        lines = self.compose_body

        if key in (curses.KEY_ENTER, 10, 13):
            line = lines[cy]
            lines[cy] = line[:cx]
            lines.insert(cy + 1, line[cx:])
            self.compose_body_cursor_y += 1
            self.compose_body_cursor_x = 0
        elif key in (curses.KEY_BACKSPACE, 127, 8):
            if cx > 0:
                line = lines[cy]
                lines[cy] = line[:cx - 1] + line[cx:]
                self.compose_body_cursor_x -= 1
            elif cy > 0:
                prev_line = lines[cy - 1]
                curr_line = lines[cy]
                self.compose_body_cursor_x = len(prev_line)
                lines[cy - 1] = prev_line + curr_line
                del lines[cy]
                self.compose_body_cursor_y -= 1
        elif key == curses.KEY_DC:
            line = lines[cy]
            if cx < len(line):
                lines[cy] = line[:cx] + line[cx + 1:]
            elif cy < len(lines) - 1:
                next_line = lines[cy + 1]
                lines[cy] = line + next_line
                del lines[cy + 1]
        elif key == curses.KEY_LEFT:
            if cx > 0:
                self.compose_body_cursor_x -= 1
            elif cy > 0:
                self.compose_body_cursor_y -= 1
                self.compose_body_cursor_x = len(lines[self.compose_body_cursor_y])
        elif key == curses.KEY_RIGHT:
            if cx < len(lines[cy]):
                self.compose_body_cursor_x += 1
            elif cy < len(lines) - 1:
                self.compose_body_cursor_y += 1
                self.compose_body_cursor_x = 0
        elif key == curses.KEY_UP:
            if cy > 0:
                self.compose_body_cursor_y -= 1
                self.compose_body_cursor_x = min(cx, len(lines[self.compose_body_cursor_y]))
            else:
                self.compose_focus = "subject"
        elif key == curses.KEY_DOWN:
            if cy < len(lines) - 1:
                self.compose_body_cursor_y += 1
                self.compose_body_cursor_x = min(cx, len(lines[self.compose_body_cursor_y]))
        elif key in (curses.KEY_HOME, 1):
            self.compose_body_cursor_x = 0
        elif key == curses.KEY_END:
            self.compose_body_cursor_x = len(lines[cy])
        elif key == curses.KEY_PPAGE:
            self.compose_body_cursor_y = max(0, cy - 10)
            self.compose_body_cursor_x = min(cx, len(lines[self.compose_body_cursor_y]))
        elif key == curses.KEY_NPAGE:
            self.compose_body_cursor_y = min(len(lines) - 1, cy + 10)
            self.compose_body_cursor_x = min(cx, len(lines[self.compose_body_cursor_y]))
        elif 32 <= key <= 126 or (key >= 160 and key < 65536):
            char = chr(key)
            line = lines[cy]
            lines[cy] = line[:cx] + char + line[cx:]
            self.compose_body_cursor_x += 1

    def prompt_search(self):
        curses.curs_set(1)
        h, w = self.stdscr.getmaxyx()
        self.stdscr.addstr(h - 1, 0, " " * (w - 1))
        self.stdscr.addstr(h - 1, 0, "Search query: ")
        curses.echo()
        query = self.stdscr.getstr(h - 1, 14, 60).decode("utf-8", errors="ignore").strip()
        curses.noecho()
        curses.curs_set(0)
        self.search_query = query
        self.selected_idx = 0
        self.status_msg = f"Filter: '{query}'" if query else "Search cleared."

    # --------------------------------------------------------------------------
    # Rendering
    # --------------------------------------------------------------------------

    def render(self):
        self.stdscr.erase()
        h, w = self.stdscr.getmaxyx()
        if h < 8 or w < 40:
            self.stdscr.addstr(0, 0, "Terminal too small!")
            self.stdscr.refresh()
            return

        if self.view_mode == "LIST":
            curses.curs_set(0)
            self.render_list_view(h, w)
        elif self.view_mode == "READER":
            curses.curs_set(0)
            self.render_reader_view(h, w)
        elif self.view_mode == "COMPOSE":
            self.render_compose_view(h, w)
        elif self.view_mode == "HELP":
            curses.curs_set(0)
            self.render_list_view(h, w)
            self.render_help_modal(h, w)
        elif self.view_mode == "FOLDERS":
            curses.curs_set(0)
            self.render_list_view(h, w)
            self.render_folder_modal(h, w)

        status_line = f" {self.status_msg} "
        if self.backend.demo:
            status_line = "[DEMO MODE] " + status_line
        self.stdscr.attron(curses.color_pair(4))
        self.stdscr.addstr(h - 1, 0, status_line.ljust(w - 1)[:w - 1])
        self.stdscr.attroff(curses.color_pair(4))

        self.stdscr.refresh()

    def render_list_view(self, h, w):
        _, folder_name = self.backend.folders[self.folder_idx]
        title = f" Gmail: [{folder_name}] "
        if self.search_query:
            title += f"(Filter: '{self.search_query}') "

        self.stdscr.attron(curses.color_pair(1) | curses.A_BOLD)
        self.stdscr.addstr(0, 0, title.ljust(w - 1)[:w - 1])
        self.stdscr.attroff(curses.color_pair(1) | curses.A_BOLD)

        header_text = f" {'ST':<3} | {'DATE':<12} | {'SENDER':<24} | {'SUBJECT'}"
        self.stdscr.addstr(1, 0, header_text[:w - 1], curses.A_DIM)
        self.stdscr.addstr(2, 0, "─" * (w - 1), curses.A_DIM)

        items = self.get_filtered_emails()
        list_h = h - 4

        if self.selected_idx < self.scroll_offset:
            self.scroll_offset = self.selected_idx
        elif self.selected_idx >= self.scroll_offset + list_h:
            self.scroll_offset = self.selected_idx - list_h + 1

        visible = items[self.scroll_offset : self.scroll_offset + list_h]

        if not visible:
            self.stdscr.addstr(4, 4, "[No messages in this mailbox or filter]", curses.A_DIM)
        else:
            for i, email_item in enumerate(visible):
                row = 3 + i
                actual_idx = self.scroll_offset + i
                is_selected = (actual_idx == self.selected_idx)

                is_unread = "\\Seen" not in email_item["flags"]
                is_starred = "\\Flagged" in email_item["flags"]

                status_char = "●" if is_unread else " "
                star_char = "★" if is_starred else " "

                sender_clean = email_item["sender"].split("<")[0].strip().replace('"', '')[:22]
                subject_clean = email_item["subject"]

                prefix = f" {status_char}{star_char} | {email_item['date']:<12} | {sender_clean:<22} | "
                row_str = (prefix + subject_clean).ljust(w - 1)[:w - 1]

                if is_selected:
                    self.stdscr.attron(curses.color_pair(1) | curses.A_BOLD)
                    self.stdscr.addstr(row, 0, row_str)
                    self.stdscr.attroff(curses.color_pair(1) | curses.A_BOLD)
                else:
                    attr = curses.A_BOLD if is_unread else curses.A_NORMAL
                    self.stdscr.addstr(row, 0, row_str, attr)

        hint_text = " [Enter] Read  [c] Compose  [r] Reply  [R] Refresh  [f] Folders  [u] Unread  [s] Star  [d] Trash  [?] Help"
        self.stdscr.addstr(h - 2, 0, hint_text.ljust(w - 1)[:w - 1], curses.A_DIM)

    def render_reader_view(self, h, w):
        e = self.current_email
        self.stdscr.attron(curses.color_pair(1) | curses.A_BOLD)
        self.stdscr.addstr(0, 0, " Gmail Message Reader ".ljust(w - 1)[:w - 1])
        self.stdscr.attroff(curses.color_pair(1) | curses.A_BOLD)

        self.stdscr.addstr(1, 2, f"Subject: {e['subject']}"[:w - 4], curses.A_BOLD)
        self.stdscr.addstr(2, 2, f"From:    {e['sender']}"[:w - 4], curses.color_pair(5))
        self.stdscr.addstr(3, 2, f"Date:    {e['date']}"[:w - 4], curses.A_DIM)
        self.stdscr.addstr(4, 0, "─" * (w - 1), curses.A_DIM)

        body_lines = []
        raw_body = e.get("body") or "[Empty Message]"
        for para in raw_body.splitlines():
            if not para.strip():
                body_lines.append("")
            else:
                while len(para) > (w - 6):
                    body_lines.append(para[:w - 6])
                    para = para[w - 6:]
                body_lines.append(para)

        content_h = h - 7
        visible_lines = body_lines[self.reader_scroll : self.reader_scroll + content_h]

        for i, line in enumerate(visible_lines):
            self.stdscr.addstr(5 + i, 2, line[:w - 4])

        hint_text = " [q/Esc] Back  [r] Reply  [c] Compose  [j/k] Scroll  [u] Unread  [s] Star  [d] Trash  [?] Help"
        self.stdscr.addstr(h - 2, 0, hint_text.ljust(w - 1)[:w - 1], curses.A_DIM)

    def render_compose_view(self, h, w):
        is_reply = bool(self.compose_in_reply_to)
        title = " Gmail: [Reply Message] " if is_reply else " Gmail: [Compose New Message] "

        self.stdscr.attron(curses.color_pair(1) | curses.A_BOLD)
        self.stdscr.addstr(0, 0, title.ljust(w - 1)[:w - 1])
        self.stdscr.attroff(curses.color_pair(1) | curses.A_BOLD)

        # To field
        to_label = " To:      "
        to_attr = curses.color_pair(1) | curses.A_BOLD if self.compose_focus == "to" else curses.color_pair(5) | curses.A_BOLD
        self.stdscr.addstr(2, 2, to_label, to_attr)
        to_val = self.compose_to
        to_w = max(10, w - 16)
        if self.compose_to_cursor >= to_w:
            visible_to = to_val[self.compose_to_cursor - to_w + 1 : self.compose_to_cursor + 1]
            render_to_x = 2 + len(to_label) + len(visible_to) - 1
        else:
            visible_to = to_val[:to_w]
            render_to_x = 2 + len(to_label) + self.compose_to_cursor
        self.stdscr.addstr(2, 2 + len(to_label), visible_to.ljust(to_w)[:to_w], curses.A_UNDERLINE)

        # Subject field
        subj_label = " Subject: "
        subj_attr = curses.color_pair(1) | curses.A_BOLD if self.compose_focus == "subject" else curses.color_pair(5) | curses.A_BOLD
        self.stdscr.addstr(3, 2, subj_label, subj_attr)
        subj_val = self.compose_subject
        subj_w = max(10, w - 16)
        if self.compose_subj_cursor >= subj_w:
            visible_subj = subj_val[self.compose_subj_cursor - subj_w + 1 : self.compose_subj_cursor + 1]
            render_subj_x = 2 + len(subj_label) + len(visible_subj) - 1
        else:
            visible_subj = subj_val[:subj_w]
            render_subj_x = 2 + len(subj_label) + self.compose_subj_cursor
        self.stdscr.addstr(3, 2 + len(subj_label), visible_subj.ljust(subj_w)[:subj_w], curses.A_UNDERLINE)

        # Separator line
        self.stdscr.addstr(4, 0, "─" * (w - 1), curses.A_DIM)

        # Body area
        body_start_y = 5
        body_h = max(1, h - 8)

        if self.compose_body_cursor_y < self.compose_scroll_y:
            self.compose_scroll_y = self.compose_body_cursor_y
        elif self.compose_body_cursor_y >= self.compose_scroll_y + body_h:
            self.compose_scroll_y = self.compose_body_cursor_y - body_h + 1

        body_lines = self.compose_body
        for i in range(body_h):
            line_idx = self.compose_scroll_y + i
            y = body_start_y + i
            if line_idx < len(body_lines):
                line_content = body_lines[line_idx]
                attr = curses.A_DIM if line_content.startswith(">") else curses.A_NORMAL
                self.stdscr.addstr(y, 2, line_content[:w - 4], attr)

        hint_text = " [Ctrl+S] Send  [Ctrl+E] Open $EDITOR (nvim)  [Tab] Next Field  [Esc] Cancel"
        self.stdscr.addstr(h - 2, 0, hint_text.ljust(w - 1)[:w - 1], curses.A_DIM)

        # Hardware cursor placement
        if self.compose_focus == "to":
            curses.curs_set(1)
            self.stdscr.move(2, min(w - 2, render_to_x))
        elif self.compose_focus == "subject":
            curses.curs_set(1)
            self.stdscr.move(3, min(w - 2, render_subj_x))
        elif self.compose_focus == "body":
            curses.curs_set(1)
            rel_y = self.compose_body_cursor_y - self.compose_scroll_y
            cur_y = body_start_y + rel_y
            cur_x = 2 + self.compose_body_cursor_x
            self.stdscr.move(min(h - 3, max(body_start_y, cur_y)), min(w - 2, cur_x))

    def render_folder_modal(self, h, w):
        modal_w = 40
        modal_h = len(self.backend.folders) + 4
        start_y = max(1, (h - modal_h) // 2)
        start_x = max(1, (w - modal_w) // 2)

        for y in range(modal_h):
            self.stdscr.addstr(start_y + y, start_x, " " * modal_w, curses.color_pair(1))

        self.stdscr.addstr(start_y + 1, start_x + 2, "Select Folder (j/k, Enter):", curses.color_pair(1) | curses.A_BOLD)

        for idx, (_, name) in enumerate(self.backend.folders):
            cursor = " \u25ba " if idx == self.folder_idx else "   "
            line = f"{cursor}{name}"
            attr = curses.A_REVERSE if idx == self.folder_idx else curses.A_NORMAL
            self.stdscr.addstr(start_y + 3 + idx, start_x + 2, line.ljust(modal_w - 4), attr)

    def render_help_modal(self, h, w):
        modal_w = 58
        modal_h = 18
        start_y = max(1, (h - modal_h) // 2)
        start_x = max(1, (w - modal_w) // 2)

        for y in range(modal_h):
            self.stdscr.addstr(start_y + y, start_x, " " * modal_w, curses.color_pair(1))

        self.stdscr.addstr(start_y + 1, start_x + 2, "GMAIL TERMINAL SHORTCUTS", curses.color_pair(1) | curses.A_BOLD)

        shortcuts = [
            ("c", "Compose new email"),
            ("r", "Reply to email (List & Reader)"),
            ("Ctrl+S / Ctrl+D", "Send email in Compose view"),
            ("Ctrl+E", "Edit draft in $EDITOR (nvim)"),
            ("Enter / o", "Open and read email"),
            ("j / k / Down / Up", "Navigate list / scroll reader"),
            ("R", "Refresh mailbox"),
            ("u", "Toggle Read / Unread"),
            ("s", "Toggle Star / Flag"),
            ("d", "Move to Trash"),
            ("f / Tab", "Switch folder (Inbox/Sent/Trash)"),
            ("/", "Search & filter by text"),
            ("q / Esc", "Back / Quit"),
        ]

        for i, (key, desc) in enumerate(shortcuts):
            row = f"  {key:<18} : {desc}"
            self.stdscr.addstr(start_y + 3 + i, start_x + 1, row[:modal_w - 2], curses.color_pair(1))

